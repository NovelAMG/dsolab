# Azure AI Foundry / Azure OpenAI-compatible chat deployment.
# Example endpoint: https://aoai-dsolab-aue.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional local-dev fallback. Prefer Entra/managed identity when possible.
# If omitted, the app uses DefaultAzureCredential and requests
# https://cognitiveservices.azure.com/.default
AZURE_OPENAI_API_KEY=

# App behavior
APP_TITLE=Foundry Chat Console
